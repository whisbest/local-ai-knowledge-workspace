# Copy to a private .runtime file. Never commit real secrets.
MULTIUSER_DATABASE_URL=postgresql+psycopg://workspace:CHANGE_ME@db:5432/workspace
MULTIUSER_DATA_ROOT=/workspace-data
MULTIUSER_MASTER_KEY=GENERATE_ONCE_WITH_PREPARATION_SCRIPT
MULTIUSER_HOSTS=localhost,127.0.0.1
MULTIUSER_ORIGINS=http://localhost:18770,http://127.0.0.1:18770
MULTIUSER_SECURE_COOKIE=false
MULTIUSER_PLATFORM_HOSTS=host.docker.internal,ollama
# Email registration: local is only for local tests; use smtp on a public server.
MULTIUSER_REGISTRATION_ENABLED=false
MULTIUSER_MAIL_BACKEND=disabled
MULTIUSER_SMTP_HOST=smtp.qq.com
MULTIUSER_SMTP_PORT=465
MULTIUSER_SMTP_SECURITY=ssl
MULTIUSER_SMTP_USERNAME=
MULTIUSER_SMTP_PASSWORD=
MULTIUSER_MAIL_FROM=
